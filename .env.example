# NeuroLearn — backend environment
# Copy to .env and fill in. NEVER commit the real .env.

# Google Gemini API key — get one at https://aistudio.google.com/apikey
# Revoke/rotate immediately if a key is ever exposed.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the Gemini model used by all agents
GEMINI_MODEL=gemini-3.5-flash

# Optional: Supabase mirror for dataset durability.
# 1) Create a project at https://supabase.com
# 2) Run backend/data/supabase_schema.sql in the SQL editor
# 3) Paste the project URL + SERVICE ROLE key (server-side only!)
# SQLite remains the operational store; rows are mirrored asynchronously.
#SUPABASE_URL=https://your-project.supabase.co
#SUPABASE_SERVICE_KEY=your_service_role_key
#SUPABASE_SYNC=1
